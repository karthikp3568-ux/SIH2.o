# ---------------------------------------------------------------------------
# Livelihood Navigator - backend environment
# Copy to `.env` and edit. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_NAME="AI-Driven Multilingual Livelihood Navigator"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# --- Security -------------------------------------------------------------
# MUST be overridden in any non-development environment. The app refuses to
# boot with ENVIRONMENT=production while this is left at the dev default.
SECRET_KEY=dev-only-insecure-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8

# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Default is a local SQLite file: zero setup, works offline, good for the demo.
# PostgreSQL example (production path, enables PostGIS + pgvector):
#   DATABASE_URL=postgresql+psycopg://navigator:navigator@localhost:5432/navigator
DATABASE_URL=sqlite:///./livelihood_navigator.db
SQL_ECHO=false

# --- AI providers ---------------------------------------------------------
# Profile extraction (what the beneficiary said -> structured profile):
#   semantic    -> multilingual meaning, not keywords (default). Uses Claude when
#                  LLM_PROVIDER=anthropic and a key is set, otherwise the offline
#                  multilingual encoder below; the lexicon is only a last resort.
#   llm         -> Claude only (falls back to the lexicon if the call fails)
#   rule_based  -> deterministic lexicon only (debugging)
PROFILE_EXTRACTOR=semantic
# Offline multilingual sentence encoder (Kannada, Hindi, Tamil, Telugu, Marathi,
# Bengali, English). Needs `pip install sentence-transformers`; ~1.9 GB, downloaded
# once into the Hugging Face cache on first use.
SEMANTIC_MODEL=sentence-transformers/LaBSE

# Embeddings for semantic retrieval:
#   local_hashing -> deterministic hashed n-gram vectors (default, offline, no model download)
#   sentence_transformers -> neural embeddings (requires the optional dependency)
EMBEDDING_PROVIDER=local_hashing
EMBEDDING_DIM=512

# LLM provider for explanation polishing / assisted extraction.
#   none      -> disabled, deterministic templates are used instead (default)
#   anthropic -> Claude via the Anthropic API
#   openai_compatible -> any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Speech / ASR:
#   browser  -> transcription happens client side via the Web Speech API (default)
#   mock     -> fixed demo transcripts, used by tests and the offline demo
#   bhashini -> BHASHINI ASR (only works when the credentials below are set)
SPEECH_PROVIDER=browser
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_ENDPOINT=

# Messaging adapters. Both are interface-only until credentials are supplied.
MESSAGING_PROVIDER=none           # none | whatsapp_cloud | ivr_webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
IVR_WEBHOOK_SECRET=

# --- Privacy / retention --------------------------------------------------
STORE_RAW_AUDIO=false             # when false, uploaded audio is never persisted
AUDIO_RETENTION_HOURS=24
TRANSCRIPT_RETENTION_DAYS=180
AUDIO_STORAGE_DIR=./var/audio
MAX_AUDIO_BYTES=5242880           # 5 MB

# --- Conversation ---------------------------------------------------------
ASR_CONFIDENCE_THRESHOLD=0.65     # below this the assistant asks for confirmation

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CONVERSATION_PER_MINUTE=40
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Demo -----------------------------------------------------------------
DEMO_MODE=true                    # exposes the seeded "Try Ravi Demo" flow
SEED_ON_STARTUP=true              # create tables + load verified seed data at boot
DEMO_ADMIN_EMAIL=admin@navigator.example.com
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_BENEFICIARY_EMAIL=ravi@navigator.example.com
DEMO_BENEFICIARY_PASSWORD=Ravi@12345
